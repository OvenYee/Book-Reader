{
    "name": "Flutter Dev Container",
    "dockerFile": "../Dockerfile",
    "runArgs": [
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "dart-code.dart-code",
                "dart-code.flutter"
            ]
        }
    },
    "remoteEnv": {
        "ANDROID_ADB_SERVER_ADDRESS": "localhost",
        "ANDROID_ADB_SERVER_PORT": "5037"
    },
    "postCreateCommand": "flutter doctor && flutter pub get"
}